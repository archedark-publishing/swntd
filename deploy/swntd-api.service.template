[Unit]
Description=SWNTD API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__DEPLOY_PATH__/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/swntd/swntd.env
ExecStart=/usr/bin/env bash -lc 'node --import tsx apps/api/src/index.ts'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=__DEPLOY_PATH__/shared

[Install]
WantedBy=multi-user.target
